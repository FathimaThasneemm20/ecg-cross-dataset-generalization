cff-version: 1.2.0
title: "Cross-Dataset Generalisation of Lightweight Deep Learning Models for ECG Arrhythmia Classification"
message: "If you use this software or the accompanying results in your research, please cite this work."
type: software

authors:
  - family-names: "Thasneem"
    given-names: "Fathima"

